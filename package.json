{
	"name": "@maple-dev/effect-clickhouse",
	"version": "0.1.2",
	"description": "Type-safe ClickHouse queries, result decoding, and reproducible benchmarks for Effect and TypeScript",
	"keywords": [
		"clickhouse",
		"effect",
		"query-builder",
		"sql",
		"typescript"
	],
	"homepage": "https://effect-clickhouse.maple.dev",
	"bugs": {
		"url": "https://github.com/MapleTechLabs/effect-clickhouse/issues"
	},
	"license": "MIT",
	"author": "Makisuo, Inc.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MapleTechLabs/effect-clickhouse.git"
	},
	"bin": {
		"ch-bench": "./dist/benchmark/bin.mjs"
	},
	"files": [
		"dist",
		"docs",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./expr": {
			"types": "./dist/expr.d.mts",
			"import": "./dist/expr.mjs"
		},
		"./types": {
			"types": "./dist/types.d.mts",
			"import": "./dist/types.mjs"
		},
		"./sql": {
			"types": "./dist/sql.d.mts",
			"import": "./dist/sql.mjs"
		},
		"./benchmark": {
			"types": "./dist/benchmark/index.d.mts",
			"import": "./dist/benchmark/index.mjs"
		},
		"./benchmark/http": {
			"types": "./dist/benchmark/http.d.mts",
			"import": "./dist/benchmark/http.mjs"
		},
		"./benchmark/cli": {
			"types": "./dist/benchmark/cli.d.mts",
			"import": "./dist/benchmark/cli.mjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
		"test": "vitest run && node scripts/check-doc-citations.mjs && node scripts/check-exports-documented.mjs && node scripts/check-doc-examples.mjs",
		"prepublishOnly": "bun run test:release",
		"test:clickhouse": "bun run build && bun scripts/test-clickhouse.ts",
		"test:package": "bun run build && bun scripts/check-package.ts",
		"test:release": "bun scripts/test-clickhouse.ts --release"
	},
	"devDependencies": {
		"@clickhouse/client": "1.21.0",
		"@effect/language-service": "^0.87.2",
		"@effect/platform-bun": "4.0.0-rc.112",
		"@effect/sql-clickhouse": "4.0.0-rc.112",
		"@effect/vitest": "4.0.0-rc.112",
		"@types/node": "^22.10.2",
		"effect": "4.0.0-rc.112",
		"expect-type": "^1.3.0",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.9"
	},
	"peerDependencies": {
		"effect": ">=4.0.0-rc.111 <5"
	},
	"packageManager": "bun@1.4.0",
	"patchedDependencies": {
		"@effect/vitest@4.0.0-rc.112": "patches/@effect%2Fvitest@4.0.0-rc.112.patch"
	}
}
